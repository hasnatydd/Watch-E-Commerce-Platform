# ARVANO — Premium Luxury Wrist Watch Environment Configuration
# TIME. PRESENCE. PRECISION.

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arvano?schema=public"
# DIRECT_URL is required for pooled databases like Neon or Supabase
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/arvano?schema=public"

# Authentication (NextAuth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="arvano-luxury-horology-ultra-secure-key-2026-bangladesh"

# Site URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ARVANO"
NEXT_PUBLIC_APP_TAGLINE="TIME. PRESENCE. PRECISION."

# Cloud Image Storage (Cloudinary - Optional in development, required in production)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SMS Provider for Bangladesh OTP & Order Notifications (Optional until credentials provided)
# Supported: Greenweb, BulkSMSBD, AlphaSMS
SMS_API_KEY=""
SMS_SENDER_ID=""

# Courier Integration (Optional until live merchant credentials provided)
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""

# Default Initial Super Admin (Used during seeding or admin provisioning script)
INITIAL_ADMIN_EMAIL="admin@arvano.com"
INITIAL_ADMIN_PASSWORD="ArvanoSuperAdmin2026!#"
